# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> General -> Your apps -> Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=
# The address of the notify worker (workers/notify), for notifications and photos.
EXPO_PUBLIC_WORKER_URL=https://weekmenu-notify.your-account.workers.dev
# Web Push (iPhone): the public key; the private one only goes in the worker.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
