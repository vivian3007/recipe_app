{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // These run elsewhere, not in the app: on Deno, on Cloudflare, or once from a computer.
  "exclude": ["supabase/functions", "workers", "scripts", "firebase", "node_modules"]
}
